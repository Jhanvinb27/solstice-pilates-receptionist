# ==============================================================================
# Solstice Pilates Receptionist - Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# Port to run FastAPI server on
PORT=8000

# ------------------------------------------------------------------------------
# LLM CONFIGURATION (OpenAI-Compatible Providers)
# ------------------------------------------------------------------------------
# Choose provider: 'openai', 'groq', 'openrouter', 'nvidia', 'ollama', etc.
LLM_PROVIDER=openai

# Model to use. Examples:
# - openai: gpt-4o, gpt-4-turbo
# - groq: llama-3.1-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
# - openrouter: meta-llama/llama-3-70b-instruct
# - nvidia: meta/llama-3-70b-instruct
# - ollama: llama3, mistral
LLM_MODEL=gpt-4o

# API Key for your LLM provider. Leave empty/unused for local Ollama.
LLM_API_KEY=your-api-key-here

# Base URL for the provider. Leave empty to use OpenAI's default. Examples:
# - groq: https://api.groq.com/openai/v1
# - openrouter: https://openrouter.ai/api/v1
# - nvidia: https://integrate.api.nvidia.com/v1
# - ollama: http://localhost:11434/v1
LLM_BASE_URL=

# ------------------------------------------------------------------------------
# GOOGLE APIS CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'True' to run using local JSON databases without calling Google APIs.
# Set to 'False' to enable real integration.
USE_MOCK_SERVICES=True

# Google Sheets Spreadsheet ID (Open the sheet in browser and copy from URL)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Calendar ID (Defaults to 'primary' for your user account)
GOOGLE_CALENDAR_ID=primary

# Path to the Google Service Account JSON key file.
# E.g., /Users/jhanvib/solstice_pilates_receptionist/service_account.json
# Alternatively, you can paste the raw JSON string directly in this variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
